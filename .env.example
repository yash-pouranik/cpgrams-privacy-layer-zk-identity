# ==============================================================================
# PRIVACY-PRESERVING CPGRAMS - ROOT ENVIRONMENT TEMPLATE
# ==============================================================================
# This monorepo consists of 3 distinct services. Copy and configure the respective
# .env files in each service directory before starting development:
#
#   1. apps/sso-server/.env.example       -> apps/sso-server/.env
#   2. apps/cpgrams-backend/.env.example  -> apps/cpgrams-backend/.env
#   3. apps/frontend/.env.example         -> apps/frontend/.env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CIVID SSO SERVER (apps/sso-server/.env) - Port 4000
# ------------------------------------------------------------------------------
# PORT=4000
# DATABASE_URL="mysql://root:yash@localhost:3306/sso_db"
# SSO_PAIRWISE_SECRET="698d62f180dda25bb95e3152e2134b358df576916af6aca49734b54c0590b811"
# SSO_ISSUER_URL="http://localhost:4000/oidc"
# CPGRAMS_CALLBACK_URL="http://localhost:5000/auth/callback"
# CPGRAMS_CLIENT_SECRET="431ba90225e063fd0ae02a7fcf7c557b2c6433a296cc95053ce20f8f9ae218e6"
# COURT_ORDER_SECRET="dev-court-secret"
# RESEND_API_KEY=""

# ------------------------------------------------------------------------------
# 2. CPGRAMS BACKEND (apps/cpgrams-backend/.env) - Port 5000
# ------------------------------------------------------------------------------
# PORT=5000
# MONGO_URI="mongodb://localhost:27017/cpgrams_db"
# SESSION_SECRET="cpgrams-dev-session-secret"
# FRONTEND_URL="http://localhost:3000"
# SSO_ISSUER_URL="http://localhost:4000/oidc"
# SSO_BASE_URL="http://localhost:4000"
# CPGRAMS_CLIENT_SECRET="431ba90225e063fd0ae02a7fcf7c557b2c6433a296cc95053ce20f8f9ae218e6"
# CPGRAMS_CALLBACK_URL="http://localhost:5000/auth/callback"
# OFFICER_JWT_SECRET="dev-officer-jwt-secret"
# COURT_ORDER_SECRET="dev-court-secret"
# DISCLOSURE_AUTHORITY_TOKEN="authority-secret-change-me"
# API_PUSH_KEYS="dev-push-key-12345"
#
# -- AI Intelligence Layer --
# AI_ENABLED=true
# MOCK_AI=false
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL_FAST="gpt-5.6-luna"
# OPENAI_MODEL_REASONING="gpt-5.6-luna"
# AI_TRIAGE_ENABLED=true
# AI_DOCUMENT_ENABLED=false
# AI_RAG_ENABLED=false
# AI_EVIDENCE_ENABLED=false
# AI_ASSIGNMENT_ENABLED=false
# PINECONE_API_KEY=""
# PINECONE_INDEX="cpgrams-index"
# PINECONE_ENVIRONMENT=""
# TAVILY_API_KEY=""
# AI_WORKER_CONCURRENCY=3
# TAVILY_MAX_RESULTS=5
# AI_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# 3. FRONTEND NEXT.JS CLIENT (apps/frontend/.env.local) - Port 3000
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_SSO_URL="http://localhost:4000"
# NEXT_PUBLIC_API_URL="http://localhost:5000"
