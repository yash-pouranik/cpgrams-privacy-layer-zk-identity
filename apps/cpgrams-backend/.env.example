# ==============================================================================
# CPGRAMS BACKEND (apps/cpgrams-backend) - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ── Core Server & Database ──────────────────────────────────────────────────
PORT=5000
MONGO_URI="mongodb://localhost:27017/cpgrams_db"
SESSION_SECRET="cpgrams-dev-session-secret-change-in-production"
FRONTEND_URL="http://localhost:3000"

# ── SSO (CivID) OIDC Integration ────────────────────────────────────────────
# NOTE: Must include the /oidc mount path for Issuer.discover
SSO_ISSUER_URL="http://localhost:4000/oidc"
SSO_BASE_URL="http://localhost:4000"
# Must match CPGRAMS_CLIENT_SECRET in apps/sso-server/.env
CPGRAMS_CLIENT_SECRET="431ba90225e063fd0ae02a7fcf7c557b2c6433a296cc95053ce20f8f9ae218e6"
CPGRAMS_CALLBACK_URL="http://localhost:5000/auth/callback"

# ── Security & Authentication ───────────────────────────────────────────────
# Secret for signing officer JWT bearer tokens
OFFICER_JWT_SECRET="dev-officer-jwt-secret-change-in-production"

# Secret for court order HMAC verification during reverse lookups (must match SSO)
COURT_ORDER_SECRET="dev-court-secret"

# Bearer / Header token required for Disclosure Authority console (/disclosure)
DISCLOSURE_AUTHORITY_TOKEN="authority-secret-change-me"

# Comma-separated API keys authorized for external department push API (/api/push/grievance)
API_PUSH_KEYS="dev-push-key-12345"

# ── AI Architecture (V2 Intelligence Orchestrator) ──────────────────────────
# Master switch — false disables all AI background tasks with zero regression
AI_ENABLED=true
REDIS_URL="redis://127.0.0.1:6379"

# Set MOCK_AI=true to return offline mock data (useful if no OpenAI API key is available)
MOCK_AI=false

# OpenAI Configuration
OPENAI_API_KEY="sk-..."
OPENAI_MODEL_FAST="gpt-5.6-luna"
OPENAI_MODEL_REASONING="gpt-5.6-luna"

# AI Pipeline Agent Feature Flags
AI_TRIAGE_ENABLED=true        # Phase 2: Urgency, Sentiment, Routing, Spam Filter
AI_DOCUMENT_ENABLED=false     # Phase 4: OCR, Vision, Document Parsing
AI_RAG_ENABLED=true           # Phase 3: Semantic Quality & Similar Case Search
AI_EVIDENCE_ENABLED=false     # Phase 5: Web Evidence Enrichment Engine
AI_ASSIGNMENT_ENABLED=true    # Phase 6: bounded AI officer recommendation + deterministic validation

# Pinecone Vector DB (Phase 3)
PINECONE_API_KEY=""
PINECONE_INDEX="cpgrams-index"
PINECONE_ENVIRONMENT=""

# Tavily Web Search (Phase 5)
TAVILY_API_KEY=""

# AI Worker Settings
AI_WORKER_CONCURRENCY=3
AI_JOB_LOCK_DURATION_MS=300000
TAVILY_MAX_RESULTS=5
AI_MAX_RETRIES=3
