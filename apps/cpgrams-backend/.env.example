# ── Existing (already in your .env) ──────────────────────────────────────────
MONGO_URI="mongodb://localhost:27017/cpgrams_db"
SSO_ISSUER_URL="http://localhost:4000/oidc"
CPGRAMS_CLIENT_SECRET=""
PORT=5000

# ── V2 AI: OpenAI ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=""
OPENAI_MODEL_FAST="gpt-5.6-luna"
OPENAI_MODEL_REASONING="gpt-5.6-luna"

# ── V2 AI: Pinecone (enable in Phase 3) ─────────────────────────────────────
PINECONE_API_KEY=""
PINECONE_INDEX="cpgrams-index"
PINECONE_ENVIRONMENT=""

# ── V2 AI: Tavily (enable in Phase 5) ────────────────────────────────────────
TAVILY_API_KEY=""

# ── AI Feature Toggles ───────────────────────────────────────────────────────
# Master switch — false = entire system works identically to pre-V2
AI_ENABLED=true

# Phase 2 (built next)
AI_TRIAGE_ENABLED=true

# Phase 3 onwards (enable when implementing that phase)
AI_RAG_ENABLED=false
AI_DOCUMENT_ENABLED=false
AI_EVIDENCE_ENABLED=false
AI_ASSIGNMENT_ENABLED=false

# ── Worker Config ─────────────────────────────────────────────────────────────
AI_WORKER_CONCURRENCY=3
TAVILY_MAX_RESULTS=5
AI_MAX_RETRIES=3

# ── Dev Shortcuts ─────────────────────────────────────────────────────────────
# Set MOCK_AI=true to skip all OpenAI/Tavily calls and use hardcoded mock outputs
MOCK_AI=false
