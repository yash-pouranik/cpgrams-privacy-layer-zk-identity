# ==============================================================================
# CIVID SSO SERVER (apps/sso-server) - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ── Core Server & Database ──────────────────────────────────────────────────
PORT=4000
DATABASE_URL="mysql://root:yash@localhost:3306/sso_db"

# ── Pairwise Pseudonymity Engine ────────────────────────────────────────────
# Secret used for HMAC-SHA256(userId + ":" + serviceId, SSO_PAIRWISE_SECRET)
SSO_PAIRWISE_SECRET="698d62f180dda25bb95e3152e2134b358df576916af6aca49734b54c0590b811"

# ── OIDC Provider Configuration ─────────────────────────────────────────────
SSO_ISSUER_URL="http://localhost:4000/oidc"
CPGRAMS_CALLBACK_URL="http://localhost:5000/auth/callback"
# Must match CPGRAMS_CLIENT_SECRET in apps/cpgrams-backend/.env
CPGRAMS_CLIENT_SECRET="431ba90225e063fd0ae02a7fcf7c557b2c6433a296cc95053ce20f8f9ae218e6"

# ── Judicial Disclosure Workflow ────────────────────────────────────────────
# Secret used to verify court order signature HMAC (must match cpgrams-backend)
COURT_ORDER_SECRET="dev-court-secret"

# ── Email OTP Delivery (Resend) ─────────────────────────────────────────────
# Optional in dev: OTP is printed in bold boxed format directly to server console
RESEND_API_KEY=""
