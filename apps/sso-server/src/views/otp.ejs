<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CivID - Verify OTP</title>
  <link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css" />
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
  <div class="hero min-h-screen bg-base-200">
    <div class="hero-content flex-col w-full max-w-md">

      <div class="text-center mb-4 w-full">
        <div class="text-xs text-base-content/50 max-w-md mx-auto px-2">
          This OTP screen is a demo of the mock data only - the code shown is NOT a real government SMS.
          It is displayed only so you can test the application.
        </div>
        <svg width="40" height="40" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="CivID" class="mx-auto mb-2">
          <path d="M 27.6 11.7 A 15 15 0 1 0 27.6 36.3" stroke="#0F172A" stroke-width="5" stroke-linecap="round"/>
          <path d="M 20.4 36.3 A 15 15 0 1 0 20.4 11.7" stroke="#F97316" stroke-width="5" stroke-linecap="round"/>
          <circle cx="24" cy="24" r="4.5" fill="#0F172A"/>
        </svg>
        <h1 class="text-4xl font-bold tracking-tight mt-2">Civ<span class="text-primary">ID</span></h1>
        <p class="text-base-content/60 mt-2">One-Time Verification</p>
      </div>

      <div class="card bg-base-100 w-full shadow-xl">
        <div class="card-body">
          <h2 class="card-title justify-center">Enter OTP</h2>
          <p class="text-center text-base-content/60 text-sm">
            OTP sent to <strong><%= maskedEmail %></strong>
          </p>

          <% if (error) { %>
            <div role="alert" class="alert alert-error alert-soft mt-2">
              <span><%= error %></span>
            </div>
          <% } %>

          <form method="POST" action="/interaction/<%= uid %>/verify" class="mt-4">
            <input type="hidden" name="aadhaar" value="<%= aadhaar %>" />

            <label class="floating-label w-full">
              <input
                id="otp-input"
                type="text"
                name="otp"
                placeholder="OTP"
                class="input input-primary w-full text-center tracking-widest text-lg"
                maxlength="6"
                pattern="\d{6}"
                inputmode="numeric"
                required
                autofocus
              />
              <span>6-digit OTP</span>
            </label>

            <div class="card-actions mt-6">
              <button type="submit" class="btn btn-primary btn-block">Verify</button>
            </div>
          </form>

          <div class="text-center mt-4">
            <form method="POST" action="/interaction/<%= uid %>/login" class="inline">
              <input type="hidden" name="aadhaar" value="<%= aadhaar %>" />
              <button type="submit" class="link link-hover link-primary text-sm">Resend OTP</button>
            </form>
          </div>
        </div>
      </div>

      <% if (otp) { %>
      <div class="card bg-base-100 w-full shadow-xl mt-4 border-2 border-primary/30">
        <div class="card-body text-center py-4">
          <p class="text-xs text-base-content/50 uppercase tracking-wider font-semibold">Demo test code</p>
          <p id="demo-otp" class="text-4xl font-black tracking-[0.3em] text-primary select-all"><%= otp %></p>
          <p class="text-xs text-base-content/50">Sent to <strong><%= maskedEmail %></strong> - valid for 5 minutes</p>
          <div class="flex gap-2 justify-center mt-2">
            <button type="button" data-copy-otp class="btn btn-outline btn-primary btn-sm gap-2" onclick="copyOtp(this)">
              Copy
            </button>
            <button type="button" class="btn btn-primary btn-sm" onclick="fillOtp()">Fill in OTP</button>
          </div>
        </div>
      </div>
      <% } %>

    </div>
  </div>

  <script>
    function copyOtp(btn) {
      var code = document.getElementById('demo-otp').innerText.trim();
      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(code);
        } else {
          var temp = document.createElement('textarea');
          temp.value = code;
          document.body.appendChild(temp);
          temp.select();
          document.execCommand('copy');
          document.body.removeChild(temp);
        }
        var old = btn.innerHTML;
        btn.innerHTML = 'Copied!';  
        setTimeout(function(){ btn.innerHTML = old; }, 1600);
      } catch (e) {}
    }

    function fillOtp() {
      var code = document.getElementById('demo-otp').innerText.trim();
      var input = document.getElementById('otp-input');
      if (input && code) {
        input.value = code;
        input.focus();
      }
    }
  </script>
</body>
</html>
