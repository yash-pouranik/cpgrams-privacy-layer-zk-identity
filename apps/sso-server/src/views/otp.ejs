<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CivID — Verify OTP</title>
  <link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css" />
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
  <div class="hero min-h-screen bg-base-200">
    <div class="hero-content flex-col w-full max-w-md">

      <div class="text-center mb-4">
        <h1 class="text-4xl font-bold tracking-tight">Civ<span class="text-primary">ID</span></h1>
        <p class="text-base-content/60 mt-2">One-Time Verification</p>
      </div>

      <div class="card bg-base-100 w-full shadow-xl">
        <div class="card-body">
          <h2 class="card-title justify-center">Enter OTP</h2>
          <p class="text-center text-base-content/60 text-sm">
            OTP sent to <strong><%= maskedEmail %></strong>
          </p>
          <div class="bg-primary/5 border border-primary/20 rounded-lg p-2 mt-2 text-center text-xs text-primary font-medium">
            Demo verification code displayed below for convenience
          </div>

          <% if (otp) { %>
          <div class="mt-3 rounded-2xl border-2 border-primary bg-base-100 shadow-lg p-4 text-center">
            <p class="text-xs text-base-content/50 uppercase tracking-wider font-semibold">Your code</p>
            <p class="text-4xl font-black tracking-[0.3em] text-primary mt-1 select-all"><%= otp %></p>
            <p class="text-xs text-base-content/50 mt-2">Valid for 5 minutes • consume it below</p>
          </div>
          <% } %>

          <% if (error) { %>
            <div role="alert" class="alert alert-error alert-soft mt-2">
              <span><%= error %></span>
            </div>
          <% } %>

          <form method="POST" action="/interaction/<%= uid %>/verify" class="mt-4">
            <input type="hidden" name="aadhaar" value="<%= aadhaar %>" />

            <label class="floating-label w-full">
              <input
                type="text"
                name="otp"
                placeholder="OTP"
                class="input input-primary w-full text-center tracking-widest text-lg"
                maxlength="6"
                pattern="\d{6}"
                inputmode="numeric"
                required
                autofocus
              />
              <span>6-digit OTP</span>
            </label>

            <div class="card-actions mt-6">
              <button type="submit" class="btn btn-primary btn-block">Verify</button>
            </div>
          </form>

          <div class="text-center mt-4">
            <form method="POST" action="/interaction/<%= uid %>/login" class="inline">
              <input type="hidden" name="aadhaar" value="<%= aadhaar %>" />
              <button type="submit" class="link link-hover link-primary text-sm">Resend OTP</button>
            </form>
          </div>
        </div>
      </div>

    </div>
  </div>
</body>
</html>
