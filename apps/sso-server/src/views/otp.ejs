<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CivID - Verify OTP</title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <style>
    body { font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; }
    .orange-panel {
      background-color: #F97316;
      background-image: radial-gradient(circle at 2px 2px, rgba(255,255,255,0.07) 1px, transparent 0),
                        radial-gradient(circle at 0.5px 0.5px, rgba(0,0,0,0.05) 0.5px, transparent 0);
      background-size: 8px 8px;
    }
  </style>
</head>
<body class="bg-[#FAFAF8] text-slate-900">
  <div class="flex min-h-screen">

    <!-- ================= LEFT: CivID Branding Panel (27%) ================= -->
    <div class="orange-panel hidden md:flex flex-col w-full md:w-[27%] shrink-0 text-white">
      <div class="px-10 lg:px-12 pt-10">
        <!-- ONE CivID logo on this page -->
        <div class="flex items-center gap-3">
          <svg width="44" height="44" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="CivID" class="shrink-0">
            <path d="M 27.6 11.7 A 15 15 0 1 0 27.6 36.3" stroke="#FFFFFF" stroke-width="5" stroke-linecap="round"/>
            <path d="M 20.4 36.3 A 15 15 0 1 0 20.4 11.7" stroke="#FFFFFF" stroke-width="5" stroke-linecap="round"/>
            <circle cx="24" cy="24" r="4.5" fill="#FFFFFF"/>
          </svg>
          <span class="text-2xl font-semibold tracking-tight">CivID</span>
        </div>
        <p class="mt-2 text-white/90 font-medium tracking-wide">One-Time Verification</p>
      </div>

      <div class="flex-1 flex flex-col items-center justify-center px-10 lg:px-12">
        <!-- Subtle privacy/security visual: protected identity inside layered boundaries -->
        <svg width="220" height="220" viewBox="0 0 220 220" fill="none" xmlns="http://www.w3.org/2000/svg" class="opacity-90" aria-hidden="true">
          <circle cx="110" cy="110" r="92" stroke="rgba(255,255,255,0.35)" stroke-width="1.5" stroke-dasharray="4 6"/>
          <circle cx="110" cy="110" r="70" stroke="rgba(255,255,255,0.5)" stroke-width="1.5"/>
          <circle cx="110" cy="110" r="48" stroke="rgba(255,255,255,0.75)" stroke-width="1.5"/>
          <path d="M 122 79 A 31 31 0 1 0 122 141" stroke="#FFFFFF" stroke-width="6" stroke-linecap="round"/>
          <path d="M 98 141 A 31 31 0 1 0 98 79" stroke="#FFFFFF" stroke-width="6" stroke-linecap="round"/>
          <circle cx="110" cy="110" r="9" fill="#FFFFFF"/>
          <line x1="110" y1="6" x2="110" y2="22" stroke="rgba(255,255,255,0.6)" stroke-width="1.5"/>
          <line x1="110" y1="198" x2="110" y2="214" stroke="rgba(255,255,255,0.6)" stroke-width="1.5"/>
          <line x1="6" y1="110" x2="22" y2="110" stroke="rgba(255,255,255,0.6)" stroke-width="1.5"/>
          <line x1="198" y1="110" x2="214" y2="110" stroke="rgba(255,255,255,0.6)" stroke-width="1.5"/>
        </svg>
      </div>

      <div class="px-10 lg:px-12 pb-10 space-y-3">
        <div class="flex items-start gap-2.5">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" class="mt-0.5 shrink-0"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <p class="text-sm text-white/85 leading-relaxed">Your identity stays sealed inside CivID. Only a pseudonymous identifier ever reaches the service you are accessing.</p>
        </div>
        <div class="flex items-start gap-2.5">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" class="mt-0.5 shrink-0"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          <p class="text-sm text-white/85 leading-relaxed">This code expires in 5 minutes and can be used only once.</p>
        </div>
      </div>
    </div>

    <!-- ================= RIGHT: OTP Verification Workspace (73%) ================= -->
    <div class="flex-1 flex flex-col min-w-0">

      <!-- Top utility area -->
      <div class="flex items-center justify-end gap-5 px-6 md:px-12 pt-5 text-xs font-medium text-slate-500">
        <a href="tel:1800114000" class="flex items-center gap-1.5 hover:text-slate-800 transition-colors">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Call Us: 1800-11-4000
        </a>
        <span class="flex items-center gap-1.5">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          English
        </span>
        <span class="flex items-center gap-1.5">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="1"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/><circle cx="12" cy="12" r="8"/></svg>
          Accessibility
        </span>
      </div>

      <!-- Breadcrumb -->
      <div class="px-6 md:px-12 pt-3">
        <nav class="text-xs text-slate-400 flex items-center gap-1.5" aria-label="Breadcrumb">
          <span>Home</span>
          <span aria-hidden="true">&rarr;</span>
          <span class="text-slate-700 font-medium">One-Time Verification</span>
        </nav>
      </div>

      <!-- Verification progress -->
      <div class="px-6 md:px-12 pt-6">
        <ol class="flex items-center w-full max-w-xl">
          <li class="flex items-center gap-2">
            <span class="w-7 h-7 rounded-full bg-emerald-600 text-white flex items-center justify-center">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span class="text-sm font-medium text-emerald-700 hidden sm:inline">Identity Verified</span>
          </li>
          <li class="flex-1 h-px bg-slate-200 mx-3"></li>
          <li class="flex items-center gap-2">
            <span class="w-7 h-7 rounded-full bg-[#F97316] text-white flex items-center justify-center text-xs font-bold ring-4 ring-orange-100">2</span>
            <span class="text-sm font-semibold text-slate-900 hidden sm:inline">OTP Verification</span>
          </li>
          <li class="flex-1 h-px bg-slate-200 mx-3"></li>
          <li class="flex items-center gap-2">
            <span class="w-7 h-7 rounded-full bg-slate-200 text-slate-400 flex items-center justify-center text-xs font-bold">3</span>
            <span class="text-sm text-slate-400 hidden sm:inline">Secure Access</span>
          </li>
        </ol>
      </div>

      <!-- Heading -->
      <div class="px-6 md:px-12 pt-8">
        <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900">Enter OTP</h1>
        <p class="text-slate-500 mt-2">
          A 6-digit one-time code was sent to <strong class="text-slate-800"><%= maskedEmail %></strong>.
          <span class="block sm:inline text-sm text-slate-400 mt-1 sm:mt-0">This OTP screen is a demo of the mock data only &mdash; the code shown is NOT a real government SMS. It is displayed only so you can test the application.</span>
        </p>
      </div>

      <!-- Main OTP card -->
      <div class="px-6 md:px-12 pt-6 pb-16 w-full max-w-2xl">
        <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-7 md:p-9">
          <% if (error) { %>
            <div role="alert" class="flex items-start gap-2.5 bg-red-50 border border-red-200 text-red-700 text-sm rounded-lg px-4 py-3 mb-5">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mt-0.5 shrink-0"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
              <span><%= error %></span>
            </div>
          <% } %>

          <form method="POST" action="/interaction/<%= uid %>/verify">
            <input type="hidden" name="aadhaar" value="<%= aadhaar %>" />

            <label for="otp-input" class="block text-sm font-semibold text-slate-700 mb-2">6-digit OTP</label>
            <input
              id="otp-input"
              type="text"
              name="otp"
              placeholder="&bull;&bull;&bull;&bull;&bull;&bull;"
              class="w-full h-16 text-center text-3xl tracking-[0.6em] font-semibold text-slate-900 border-2 border-slate-300 rounded-lg bg-white placeholder-slate-300 focus:outline-none focus:border-[#F97316] focus:ring-4 focus:ring-orange-100 transition-all"
              maxlength="6"
              pattern="\d{6}"
              inputmode="numeric"
              required
              autofocus
            />

            <button type="submit" class="w-full h-12 mt-6 bg-[#F97316] hover:bg-[#EA580C] text-white font-semibold rounded-lg transition-colors focus:outline-none focus:ring-4 focus:ring-orange-200">
              Verify
            </button>
          </form>

          <div class="text-center mt-5">
            <form method="POST" action="/interaction/<%= uid %>/login" class="inline">
              <input type="hidden" name="aadhaar" value="<%= aadhaar %>" />
              <button type="submit" class="text-sm font-medium text-[#F97316] hover:text-[#EA580C] hover:underline underline-offset-4 transition-colors">Resend OTP</button>
            </form>
          </div>
        </div>

        <% if (otp) { %>
        <!-- Demo / developer helper card (subordinate) -->
        <div class="mt-5 bg-slate-50 border border-slate-200 rounded-xl p-5">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
              <p class="text-[11px] uppercase tracking-wider font-semibold text-slate-400">Demo test code</p>
              <p id="demo-otp" class="text-3xl font-bold tracking-[0.3em] text-slate-700 select-all mt-1"><%= otp %></p>
              <p class="text-xs text-slate-400 mt-1">Sent to <strong><%= maskedEmail %></strong> &mdash; valid for 5 minutes</p>
            </div>
            <div class="flex gap-2 shrink-0">
              <button type="button" data-copy-otp class="h-9 px-4 text-sm font-medium border border-slate-300 text-slate-700 rounded-lg hover:bg-white hover:border-slate-400 transition-colors" onclick="copyOtp(this)">
                Copy
              </button>
              <button type="button" class="h-9 px-4 text-sm font-medium bg-slate-800 text-white rounded-lg hover:bg-slate-900 transition-colors" onclick="fillOtp()">Fill in OTP</button>
            </div>
          </div>
        </div>
        <% } %>
      </div>

    </div>
  </div>

  <script>
    function copyOtp(btn) {
      var code = document.getElementById('demo-otp').innerText.trim();
      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(code);
        } else {
          var temp = document.createElement('textarea');
          temp.value = code;
          document.body.appendChild(temp);
          temp.select();
          document.execCommand('copy');
          document.body.removeChild(temp);
        }
        var old = btn.innerHTML;
        btn.innerHTML = 'Copied!';  
        setTimeout(function(){ btn.innerHTML = old; }, 1600);
      } catch (e) {}
    }

    function fillOtp() {
      var code = document.getElementById('demo-otp').innerText.trim();
      var input = document.getElementById('otp-input');
      if (input && code) {
        input.value = code;
        input.focus();
      }
    }
  </script>
</body>
</html>
