<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CivID — Identity Custodian Vault</title>
  <link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css" />
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&family=Inter:wght@400;600;700;800&family=JetBrains+Mono:wght@700&display=swap" rel="stylesheet" />
  <style>
    body {
      font-family: 'Inter', sans-serif;
    }
  </style>
</head>
<body class="bg-[#FAFAF8] text-[#2F2B27] min-h-screen flex flex-col justify-between">

  <!-- Header -->
  <header class="border-b border-[#E5E7EB] bg-white px-6 py-4 shadow-2xs">
    <div class="max-w-6xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-3">
        <!-- Official interlocked-rings SVG logo -->
        <svg class="w-8 h-8" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="20" cy="24" r="12" stroke="#2F2B27" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" />
          <circle cx="28" cy="24" r="12" stroke="#F97316" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" />
          <circle cx="24" cy="24" r="3.5" fill="#F97316" />
        </svg>
        <div>
          <span class="text-lg font-extrabold text-[#2F2B27]">Civ<span class="text-[#F97316]">ID</span></span>
          <span class="text-[9px] font-bold block text-gray-500 tracking-widest uppercase">Identity Vault</span>
        </div>
      </div>
      <div class="flex items-center gap-4 text-xs font-semibold text-gray-500">
        <span class="flex items-center gap-1.5 text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200">
          <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-pulse"></span> Vault Secured
        </span>
      </div>
    </div>
  </header>

  <!-- Hero Section -->
  <main class="flex-1 max-w-4xl mx-auto w-full px-6 py-16 flex flex-col items-center justify-center text-center space-y-8">
    
    <div class="space-y-4">
      <div class="badge bg-[#FFF7ED] border-[#FFEDD5] text-[#D97706] text-[10px] font-bold tracking-wider uppercase px-3 py-1.5 rounded-full mx-auto">
        🛡️ State-Managed Single Sign-On (SSO)
      </div>
      <h1 class="text-4xl md:text-5xl font-black tracking-tight text-[#2F2B27] max-w-2xl">
        Verify the Citizen.<br>
        <span class="text-[#F97316]">Protect the Identity.</span>
      </h1>
      <p class="text-sm md:text-base text-gray-600 max-w-lg mx-auto leading-relaxed">
        CivID is an isolated, air-gapped identity custodian. We verify your credentials securely and issue pseudonymous tokens, ensuring zero leaks of personal details.
      </p>
    </div>

    <!-- Core Guarantees Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 w-full max-w-3xl pt-4">
      
      <div class="p-5 bg-white border border-[#E5E7EB] rounded-2xl text-left shadow-2xs space-y-2">
        <div class="p-2 bg-[#FFF7ED] text-[#F97316] w-fit rounded-lg">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
        </div>
        <h3 class="text-xs font-bold text-gray-900 uppercase">PII Isolation</h3>
        <p class="text-[11px] text-gray-500 leading-relaxed">Your Aadhaar, mobile, and address are sealed. Downstream portals only see a pseudonymous identifier.</p>
      </div>

      <div class="p-5 bg-white border border-[#E5E7EB] rounded-2xl text-left shadow-2xs space-y-2">
        <div class="p-2 bg-[#EEF2FF] text-[#4F46E5] w-fit rounded-lg">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <h3 class="text-xs font-bold text-gray-900 uppercase">Cryptographic Seal</h3>
        <p class="text-[11px] text-gray-500 leading-relaxed">Unique pairwiseIds are dynamically generated using HMAC-SHA256 keys, preventing cross-profile linking.</p>
      </div>

      <div class="p-5 bg-white border border-[#E5E7EB] rounded-2xl text-left shadow-2xs space-y-2">
        <div class="p-2 bg-[#ECFDF5] text-[#059669] w-fit rounded-lg">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
        <h3 class="text-xs font-bold text-gray-900 uppercase">Auditable Reveal</h3>
        <p class="text-[11px] text-gray-500 leading-relaxed">Identity maps can only be requested via a strict, court-signed order, logged forever in the tamper-proof vault ledger.</p>
      </div>

    </div>

    <!-- Actions -->
    <div class="pt-4 flex flex-col sm:flex-row items-center gap-4">
      <a href="<%= frontendUrl %>" class="btn bg-[#F97316] hover:bg-[#EA580C] text-white border-0 px-8 py-3.5 rounded-xl shadow-xs text-xs font-semibold">
        Go to CPGRAMS Grievance Portal
      </a>
      <span class="text-xs text-gray-400 font-mono">
        SSO Issuer URL: <code class="bg-gray-100 px-1.5 py-0.5 rounded text-gray-700">sso.bitbros.in/oidc</code>
      </span>
    </div>

  </main>

  <!-- Footer -->
  <footer class="border-t border-[#E5E7EB] bg-white px-6 py-6 text-center text-xs text-gray-400">
    <div class="max-w-6xl mx-auto space-y-1">
      <p class="font-bold text-gray-600">CivID Identity Federation Custodian</p>
      <p>Ministry of Electronics and Information Technology (MeitY) — Government of India</p>
      <p class="text-[10px] text-gray-400/80 pt-2">© 2026 CivID. All rights reserved. For administrative inquiries, contact warrant-gateway@bitbros.in</p>
    </div>
  </footer>

</body>
</html>
